Write a C program to accept details of n students (roll number, name, percentage) using structure. Display details of the student having maximum percentage.*/
#include<stdio.h>
#include<string.h>
#include<stdlib.h>
struct student 
{
	int rollno;
	char name[20];
	float per;
};
void main()
{
	struct student s[100];
	int i,n;
	int max_percentage;
	printf("Enter the number of students to be stored: ");
	scanf("%d",&n);
	printf("\n----------------------------------\n");	
	for(i=0;i<n;i++)
	{
		printf("Enter the details of student %d",i+1);
		printf("\n----------------------------------");	
		printf("\nROLL NO: ");
		scanf("%d",&s[i].rollno);
		printf("Name: ");
		scanf("%s",s[i].name);
		printf("percentage : ");
		scanf("%f",&s[i].per);
		printf("\n----------------------------------\n");
	}
	max_percentage=s[0].per;
	for(i=0;i<n;i++)
	{
		if(s[i].per>max_percentage)
		{
			max_percentage=s[i].per;
		}
	}

	printf("\nDetails Of Student Having Maximum percentage\n");
	printf("\n----------------------------------\n");
	printf("ROLLNO\tNAME\tPERCENTAGE\n");
	printf("\n----------------------------------\n");		
	for(i=0;i<n;i++)
	{
		if(s[i].per==max_percentage)
		{
			printf("%d\t",s[i].rollno);
			printf("%s\t",s[i].name);
			printf("%.2f\t",s[i].per);
			printf("\n----------------------------------\n");
		}
	}
}	